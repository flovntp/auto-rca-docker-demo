# Copy to .env and fill in. Never commit .env.
APP_SECRET=            # openssl rand -hex 16
RCA_RUNNER_SECRET=     # openssl rand -hex 32, shared by the app and the runner
ANTHROPIC_API_KEY=     # ideally from a workspace with a spending limit
# Fine-grained token, this repository only: Contents, Issues, Pull requests (read and write)
GITHUB_TOKEN=
GITHUB_REPO=flovntp/auto-rca-docker-demo
CLAUDE_MODEL=claude-sonnet-5-5
