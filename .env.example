# Copy to .env and fill in. Never commit .env.
APP_SECRET=            # openssl rand -hex 16
RCA_RUNNER_SECRET=     # openssl rand -hex 32, shared by the worker and the runner
ANTHROPIC_API_KEY=     # ideally from a workspace with a spending limit
# Fine-grained tokens, this repository only. The runner's (coding agent): Contents, Issues, Pull requests (read and write)
GITHUB_TOKEN=
# The worker's (triage): Issues (read and write), nothing else
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=flovntp/auto-rca-docker-demo
CLAUDE_MODEL=claude-sonnet-5-5   # the coding agent
TRIAGE_MODEL=claude-haiku-5-5   # the triage
# Synology: its kernel has no CFS scheduler, so the agent gets a CPU weight instead of --cpus
#AGENT_CPU_SHARES=512
# Synology: its 3.10 kernel has no getrandom(), which git needs; this shim reads /dev/urandom instead
#AGENT_PRELOAD=/usr/local/lib/libgetrandom-shim.so
